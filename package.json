{
  "name": "htmlplayer",
  "version": "1.0.0",
  "description": "Broadcast HTML Graphics Player & Server for CeftoDecklink and CasparCG playout",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:cpp": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -ExecutionPolicy Bypass -File ./scripts/build.ps1",
    "start:cpp": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -Command \"Start-Process ./build/Release/CeftoDecklink.exe\""
  },
  "keywords": [
    "casparcg",
    "decklink",
    "broadcast",
    "html5",
    "graphics",
    "lower-thirds",
    "ticker"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.17.0"
  }
}
